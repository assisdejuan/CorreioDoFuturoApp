<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/papel"
    tools:context=".CriarCapsulaActivity">

    <View
        android:id="@+id/faixa_aerea_topo"
        android:layout_width="0dp"
        android:layout_height="@dimen/altura_faixa"
        android:background="@drawable/faixa_aerea"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guia_colunas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rolagem_formulario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guia_colunas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/faixa_aerea_topo">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cartao_postal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margem_tela"
                app:cardBackgroundColor="@color/branco_postal"
                app:cardCornerRadius="4dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/espaco_g"
                app:layout_constraintTop_toTopOf="parent">
        
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp">
        
                    <TextView
                        android:id="@+id/texto_rotulo_cartao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="@string/rotulo_cartao"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/vermelho_aereo"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
        
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_campo_autor"
                        style="@style/Campo.Postal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_m"
                        android:hint="@string/dica_autor"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/texto_rotulo_cartao">
        
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campo_autor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
        
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_campo_titulo"
                        style="@style/Campo.Postal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_p"
                        android:hint="@string/dica_titulo"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layout_campo_autor">
        
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campo_titulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textCapSentences"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
        
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_campo_ano"
                        style="@style/Campo.Postal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_p"
                        android:hint="@string/dica_ano"
                        app:helperText="@string/ajuda_ano"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layout_campo_titulo"
                        app:layout_constraintWidth_percent="0.55">
        
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campo_ano"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="4"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
        
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_campo_mensagem"
                        style="@style/Campo.Postal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_p"
                        android:hint="@string/dica_mensagem"
                        app:counterEnabled="true"
                        app:counterMaxLength="600"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layout_campo_ano">
        
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campo_mensagem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="600"
                            android:minLines="5" />
                    </com.google.android.material.textfield.TextInputLayout>
        
                    <TextView
                        android:id="@+id/texto_rotulo_importancia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/espaco_m"
                        android:text="@string/rotulo_importancia"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/tinta"
                        app:layout_constraintBaseline_toBaselineOf="@id/texto_valor_importancia"
                        app:layout_constraintEnd_toStartOf="@id/texto_valor_importancia"
                        app:layout_constraintStart_toStartOf="parent" />
        
                    <TextView
                        android:id="@+id/texto_valor_importancia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_m"
                        android:fontFamily="serif"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                        android:textColor="@color/vermelho_aereo"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layout_campo_mensagem"
                        tools:text="50%" />
        
                    <SeekBar
                        android:id="@+id/barra_importancia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50"
                        android:progressTint="@color/vermelho_aereo"
                        android:thumbTint="@color/azul_aereo"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/texto_valor_importancia" />
        
                    <TextView
                        android:id="@+id/texto_importancia_min"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaco_m"
                        android:text="@string/importancia_minima"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@color/tinta_suave"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/barra_importancia" />
        
                    <TextView
                        android:id="@+id/texto_importancia_max"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/espaco_m"
                        android:text="@string/importancia_maxima"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@color/tinta_suave"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/barra_importancia" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_selar"
                style="@style/Botao.Selar"
                android:layout_width="0dp"
                android:layout_height="@dimen/altura_botao"
                android:layout_marginHorizontal="@dimen/margem_tela"
                android:layout_marginTop="@dimen/espaco_g"
                android:layout_marginBottom="@dimen/espaco_g"
                android:text="@string/botao_selar"
                android:textStyle="bold"
                app:icon="@drawable/ic_lacre"
                app:iconGravity="textStart"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cartao_postal"
                app:layout_constraintVertical_bias="0" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageView
        android:id="@+id/imagem_selo"
        android:layout_width="@dimen/tamanho_selo"
        android:layout_height="0dp"
        android:contentDescription="@string/desc_selo"
        android:rotation="-4"
        android:src="@drawable/ic_selo_relogio"
        app:layout_constraintDimensionRatio="5:6"
        app:layout_constraintStart_toEndOf="@id/guia_colunas"
        app:layout_constraintVertical_bias="0.25"
        android:layout_marginBottom="@dimen/espaco_g"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/faixa_aerea_topo"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/texto_titulo_app"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_g"
        android:layout_marginTop="@dimen/espaco_m"
        android:layout_marginEnd="@dimen/margem_tela"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="@string/titulo_app"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
        android:textColor="@color/tinta"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guia_colunas"
        app:layout_constraintTop_toBottomOf="@id/imagem_selo" />

    <TextView
        android:id="@+id/texto_subtitulo_app"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_p"
        android:fontFamily="serif"
        android:text="@string/subtitulo_app"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/tinta_suave"
        android:textStyle="italic"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="@id/texto_titulo_app"
        app:layout_constraintStart_toStartOf="@id/texto_titulo_app"
        app:layout_constraintTop_toBottomOf="@id/texto_titulo_app" />

</androidx.constraintlayout.widget.ConstraintLayout>
